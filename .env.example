# Server-side Laravel API base URL used by Next.js BFF Route Handlers
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Public Laravel base URL (for display/asset links)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Stripe Test Mode Publishable Key ONLY (never put sk_test_ here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
